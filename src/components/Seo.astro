---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import defaultOgSource from '../assets/profile.jpg';

interface Props {
  title: string;
  description?: string;
  /** Page-specific social preview image; falls back to the profile photo. */
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
  /** Article publication date, emitted as article:published_time. */
  publishedTime?: Date;
  /** Keep the page out of search results, e.g. the 404. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage,
  ogType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogSource = ogImage ?? defaultOgSource;
const og = await getImage({ src: ogSource, width: 1200, format: 'jpeg' });
const ogImageUrl = new URL(og.src, Astro.site);
// Astro never upscales, so the emitted size is capped by the source width.
const ogWidth = Math.min(1200, ogSource.width);
const ogHeight = Math.round(ogSource.height * (ogWidth / ogSource.width));
// Square images are cropped badly in a large-image card; use the compact card.
const twitterCard = ogWidth / ogHeight < 1.5 ? 'summary' : 'summary_large_image';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={ogImage ? title : `Portrait of ${site.name}`} />
{
  ogType === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
    <meta property="article:author" content={site.name} />
  )
}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImage ? title : `Portrait of ${site.name}`} />
