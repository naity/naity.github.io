---
import { Image, getImage } from 'astro:assets';
import { photos } from '../data/photos';

// Pre-generate large renditions for the lightbox.
const large = await Promise.all(
  photos.map((photo) => getImage({ src: photo.src, width: 2000, format: 'webp' }))
);
---

<div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
  {
    photos.map((photo, i) => (
      <button
        type="button"
        class="group mb-4 block w-full cursor-zoom-in break-inside-avoid overflow-hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        data-lightbox-src={large[i]!.src}
        data-lightbox-alt={photo.alt}
        aria-label={`View photo: ${photo.alt}`}
      >
        <Image
          src={photo.src}
          alt={photo.alt}
          width={800}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 320px, (min-width: 640px) 45vw, 92vw"
          class="w-full rounded-xl transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </button>
    ))
  }
</div>

<dialog
  id="lightbox"
  class="m-auto max-h-dvh max-w-[min(96vw,1400px)] bg-transparent p-4 backdrop:bg-zinc-950/90"
>
  <img src="" alt="" class="mx-auto max-h-[85dvh] w-auto rounded-lg" />
  <p class="mt-3 text-center text-sm text-zinc-300"></p>
  <button
    type="button"
    id="lightbox-close"
    aria-label="Close"
    class="absolute top-2 right-2 rounded-full bg-zinc-900/70 p-2 text-zinc-200 transition-colors duration-150 hover:bg-zinc-800 hover:text-white"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = dialog?.querySelector('img');
  const caption = dialog?.querySelector('p');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]')];
  let current = -1;

  function show(index: number) {
    const thumb = thumbs[index];
    if (!dialog || !img || !caption || !thumb) return;
    current = index;
    img.src = thumb.dataset.lightboxSrc ?? '';
    img.alt = thumb.dataset.lightboxAlt ?? '';
    caption.textContent = thumb.dataset.lightboxAlt ?? '';
    if (!dialog.open) dialog.showModal();
  }

  thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index)));

  document.getElementById('lightbox-close')?.addEventListener('click', () => dialog?.close());

  // Close when the backdrop (the dialog element itself) is clicked.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.addEventListener('keydown', (event) => {
    if (!dialog?.open) return;
    if (event.key === 'ArrowRight') show((current + 1) % thumbs.length);
    if (event.key === 'ArrowLeft') show((current - 1 + thumbs.length) % thumbs.length);
  });
</script>
