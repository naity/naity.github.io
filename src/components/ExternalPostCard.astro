---
import { formatDate } from '../lib/format';
import type { ExternalPost } from '../data/externalPosts';

interface Props {
  post: ExternalPost;
}

const { post } = Astro.props;
const { title, date, url, source, description, tags = [] } = post;
const parsed = new Date(date);
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col gap-5 rounded-xl border border-zinc-200 p-5 transition-colors duration-150 hover:border-accent/50 hover:bg-zinc-50 sm:flex-row dark:border-zinc-800 dark:hover:border-accent-light/50 dark:hover:bg-zinc-900"
>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-500 dark:text-zinc-500">
      <time datetime={date}>{formatDate(parsed)}</time>
      <span aria-hidden="true">&middot;</span>
      <span
        class="inline-flex items-center gap-1 rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"
      >
        {source}
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3"
        >
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </span>
    </div>
    <h3
      class="mt-1 font-semibold text-balance text-zinc-900 transition-colors duration-150 group-hover:text-accent dark:text-zinc-100 dark:group-hover:text-accent-light"
    >
      {title}
    </h3>
    <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {description}
    </p>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</a>
