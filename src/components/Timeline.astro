---
import { experience } from '../data/experience';
---

<ol class="relative space-y-10 border-l border-zinc-200 pl-6 dark:border-zinc-800">
  {
    experience.map((entry) => (
      <li class="relative">
        <span
          class="absolute top-1.5 -left-[1.85rem] size-3 rounded-full border-2 border-white bg-accent dark:border-zinc-950 dark:bg-accent-light"
          aria-hidden="true"
        />
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">{entry.org}</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-500">{entry.period}</p>
        </div>
        {(entry.role || entry.location) && (
          <p class="mt-0.5 text-sm font-medium text-zinc-600 dark:text-zinc-400">
            {entry.role}
            {entry.role && entry.location && <span class="text-zinc-400 dark:text-zinc-600"> · </span>}
            {entry.location}
          </p>
        )}
        <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{entry.summary}</p>
      </li>
    ))
  }
</ol>
