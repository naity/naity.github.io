---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import PostCard from '../components/PostCard.astro';
import ExternalPostCard from '../components/ExternalPostCard.astro';
import { site, socials } from '../data/site';
import { projects } from '../data/projects';
import { education, experience } from '../data/experience';
import { getWritingFeed } from '../lib/posts';
import profile from '../assets/profile.jpg';

const featured = projects.filter((p) => p.featured);
const recentPosts = (await getWritingFeed()).slice(0, 3);
const publicationCount = (await getCollection('publications')).length;

const current = experience[0];

// A stable @id lets other pages reference this same entity as their author.
// Derived from Astro.site so a domain change only needs astro.config.mjs.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name: site.name,
  givenName: 'Yuan',
  familyName: 'Tian',
  url: new URL('/', Astro.site).href,
  image: new URL(profile.src, Astro.site).href,
  description: site.description,
  jobTitle: current.role,
  worksFor: { '@type': 'Organization', name: current.org },
  alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.org })),
  homeLocation: { '@type': 'Place', name: site.location },
  sameAs: socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
  knowsAbout: [
    'Machine Learning',
    'Deep Learning',
    'Generative AI',
    'AI Agents',
    'Large Language Models',
    'Computational Biology',
    'Bioinformatics',
    'Immunology',
  ],
});
---

<BaseLayout title={`${site.name} — Building AI/ML applications`} description={site.description}>
  <script type="application/ld+json" set:html={jsonLd} is:inline />

  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-4 pt-20 pb-16 sm:px-6 md:pt-28 md:pb-24">
    <div class="fade-up max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100">
        Hi, I'm Yuan <span class="inline-block origin-[70%_70%] hover:animate-none">👋</span>
      </h1>
      <p class="mt-5 text-xl leading-relaxed text-zinc-700 sm:text-2xl dark:text-zinc-300">
        {site.tagline.replace(/\.$/, '')}<span class="text-accent dark:text-accent-light">.</span>
      </p>
      <p class="mt-4 max-w-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
        Generative AI, machine learning, and deep learning, with roots in computational
        immunology research.
      </p>
      <p class="mt-3 flex items-center gap-1.5 text-sm text-zinc-500 dark:text-zinc-500">
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {site.location}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/projects/"
          class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-colors duration-150 hover:bg-accent/90"
        >
          View projects
        </a>
        <a
          href="/publications/"
          class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors duration-150 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800"
        >
          Publications
        </a>
      </div>
      <SocialIcons class="mt-6 -ml-2" />
    </div>
  </section>

  <!-- About -->
  <section class="border-t border-zinc-200/70 dark:border-zinc-800/70">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
      <div class="grid items-center gap-10 md:grid-cols-[1fr_auto]">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">About</h2>
          <div class="mt-4 space-y-4 leading-relaxed text-zinc-600 dark:text-zinc-400">
            <p>
              I work at the intersection of AI and biomedicine. Trained as an immunologist, I
              spent years decoding how T cells respond to viruses like dengue and SARS-CoV-2,
              and how they can be engineered to fight cancer. These days I build AI agents for
              various applications.
            </p>
          </div>
        </div>
        <Image
          src={profile}
          alt="Portrait of Yuan Tian"
          width={480}
          class="mx-auto size-44 rounded-full border border-zinc-200 object-cover md:size-56 dark:border-zinc-800"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="border-t border-zinc-200/70 dark:border-zinc-800/70">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Featured projects
        </h2>
        <a
          href="/projects/"
          class="text-sm font-medium text-accent hover:underline dark:text-accent-light"
        >
          All projects →
        </a>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((project) => <ProjectCard {project} />)}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="border-t border-zinc-200/70 dark:border-zinc-800/70">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Experience</h2>
      <div class="mt-8 max-w-3xl">
        <Timeline />
      </div>

      <h3 class="mt-14 text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Education
      </h3>
      <ul class="mt-5 max-w-3xl space-y-4">
        {
          education.map((entry) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
              <div>
                <p class="font-semibold text-zinc-900 dark:text-zinc-100">{entry.org}</p>
                <p class="mt-0.5 text-sm font-medium text-zinc-600 dark:text-zinc-400">
                  {entry.role}
                </p>
              </div>
              <p class="text-sm text-zinc-500 dark:text-zinc-500">{entry.period}</p>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 text-sm text-zinc-500 dark:text-zinc-500">
        {publicationCount} research publications along the way. <a href="/publications/" class="font-medium text-accent hover:underline dark:text-accent-light">Browse them here</a>.
      </p>
    </div>
  </section>

  <!-- Recent writing -->
  <section class="border-t border-zinc-200/70 dark:border-zinc-800/70">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Recent writing
        </h2>
        <a
          href="/blog/"
          class="text-sm font-medium text-accent hover:underline dark:text-accent-light"
        >
          All posts →
        </a>
      </div>
      <div class="mt-8 grid gap-4">
        {
          recentPosts.map((entry) =>
            entry.kind === 'native' ? (
              <PostCard post={entry.native} />
            ) : (
              <ExternalPostCard post={entry.external} />
            )
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
